{
  "name": "@proteinjs/jest-preset",
  "version": "1.4.0",
  "description": "Shared jest preset — the one CI test practice (DECISIONS 1121): transpile-only ts-jest (tsconfig.isolatedModules), worker/memory convergence knobs, the in-band declaration (package.json jestPreset.inBand), standard setup hooks; the practice's judge (practice.js — a pure read of package.json + jest.config.js, P1–P3) and ts-jest's one floor",
  "main": "jest-preset.js",
  "files": [
    "jest-preset.js",
    "JestPresetBuilder.js",
    "knobs.js",
    "practice.js",
    "practice.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proteinjs/build.git"
  },
  "bugs": {
    "url": "https://github.com/proteinjs/build/issues"
  },
  "homepage": "https://github.com/proteinjs/build#readme",
  "author": "Brent Bahry",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf node_modules/",
    "build": "node -e \"require('./jest-preset.js'); require('./knobs.js')\"",
    "test": "jest --passWithNoTests"
  },
  "peerDependencies": {
    "jest": ">=29.0.0 <30",
    "ts-jest": ">=29.3.0 <30"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.8.0",
    "@typescript-eslint/parser": "7.8.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "jest": "29.7.0",
    "ts-jest": "29.4.5",
    "typescript": "5.2.2"
  }
}
