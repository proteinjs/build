{
  "name": "@proteinjs/jest-preset",
  "version": "1.2.0",
  "description": "Shared jest preset: transpile-only ts-jest (tsconfig.isolatedModules), worker/memory convergence knobs, standard setup hooks",
  "main": "jest-preset.js",
  "files": [
    "jest-preset.js",
    "JestPresetBuilder.js",
    "knobs.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proteinjs/build.git"
  },
  "bugs": {
    "url": "https://github.com/proteinjs/build/issues"
  },
  "homepage": "https://github.com/proteinjs/build#readme",
  "author": "Brent Bahry",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf node_modules/",
    "build": "node -e \"require('./jest-preset.js'); require('./knobs.js')\"",
    "test": "jest"
  },
  "peerDependencies": {
    "jest": ">=29.0.0 <30",
    "ts-jest": ">=29.3.0 <30"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.8.0",
    "@typescript-eslint/parser": "7.8.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "jest": "29.7.0",
    "ts-jest": "29.4.5",
    "typescript": "5.2.2"
  }
}
